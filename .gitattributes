# 줄바꿈 고정 — Unity 에셋(YAML)은 LF, 이진 파일은 diff 제외
* text=auto
*.cs text eol=lf diff=csharp
*.md text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.json text eol=lf

*.png binary
*.jpg binary
*.psd binary
*.fbx binary
*.glb binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
